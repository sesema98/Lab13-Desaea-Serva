@host = http://localhost:5000

GET {{host}}/api/observatorios
Accept: application/json

###
GET {{host}}/api/reservasobservacion?estado=Confirmada&desde=2027-01-01
Accept: application/json

###
POST {{host}}/api/observatorios
Content-Type: application/json

{
  "nombre": "Ventana del Cosmos",
  "ciudad": "Cusco",
  "capacidad": 30,
  "activo": true
}

